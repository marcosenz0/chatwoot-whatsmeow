<%
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  is_saml_account = account_user&.account&.saml_enabled?
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = 'Bem-vindo'
  heading = 'Confirme seu e-mail para começar'
  intro_text =
    "Bem-vindo ao #{brand_name}. Precisamos verificar seu endereço de e-mail antes de você começar a usar sua conta."
  supporting_text = 'Leva só um instante.'
  action_text = 'Confirmar minha conta'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << ['Novo e-mail', @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = 'Atualização de e-mail'
    heading = 'Confirme seu novo endereço de e-mail'
    intro_text = "Recebemos uma solicitação para atualizar o endereço de e-mail da sua conta no #{brand_name}."
    supporting_text = 'Confirme o novo endereço abaixo para concluir a alteração.'
    action_text = 'Confirmar endereço de e-mail'
  elsif @resource.confirmed?
    eyebrow = 'Conta pronta'

    if is_saml_account
      heading = 'Seu acesso está pronto'
      intro_text = "Seu acesso ao #{brand_name} já está configurado."
      supporting_text = "Use o portal de Single Sign-On (SSO) da sua organização para acessar o #{brand_name}."
      action_text = nil
      action_url = nil
      info_title = 'Entre com o SSO da sua organização'
      info_text =
        "Você não precisa de uma senha separada para o #{brand_name}. Comece pelo portal de identidade da sua empresa."
      detail_rows = []
      detail_rows << ['Espaço', account_name] if account_name.present?
      detail_rows << ['Método de entrada', 'Single Sign-On (SSO)']
    else
      heading = 'Sua conta está pronta'
      intro_text = "Sua conta no #{brand_name} já está ativa."
      supporting_text = 'Use o botão abaixo para entrar e continuar de onde parou.'
      action_text = 'Abrir minha conta'
      action_url = frontend_url('auth/sign_in')
      detail_rows = []
    end
  elsif invited_user
    eyebrow = 'Convite para o espaço'
    heading = account_name.present? ? "Você foi convidado para participar de #{account_name}" : "Você foi convidado para experimentar #{brand_name}"

    if is_saml_account
      intro_text = if account_name.present?
        "#{inviter.name} convidou você para acessar o espaço #{account_name} no #{brand_name}."
      else
        "#{inviter.name} convidou você para acessar o #{brand_name}."
      end
      supporting_text =
        'Sua organização usa Single Sign-On (SSO), então você não precisa criar uma senha separada.'
      action_text = nil
      action_url = nil
      info_title = 'Use o portal SSO da sua organização'
      info_text = "Continue pelo portal de identidade da sua empresa para acessar o #{brand_name}."
      detail_rows = [['Convidado por', inviter.name]]
      detail_rows << ['Espaço', account_name] if account_name.present?
      detail_rows << ['Método de entrada', 'Single Sign-On (SSO)']
    else
      intro_text = if account_name.present?
        "#{inviter.name} convidou você para participar do espaço #{account_name} no #{brand_name}."
      else
        "#{inviter.name} convidou você para experimentar #{brand_name}."
      end
      supporting_text = 'Crie sua conta para começar a colaborar com sua equipe.'
      action_text = 'Aceitar convite'
      action_url = frontend_url(
        'auth/password/edit',
        reset_password_token: @resource.send(:set_reset_password_token)
      )
      detail_rows = [['Convidado por', inviter.name]]
      detail_rows << ['Espaço', account_name] if account_name.present?
    end
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
