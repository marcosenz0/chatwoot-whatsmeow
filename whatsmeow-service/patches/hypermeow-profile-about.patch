+package whatsmeow
+
+import (
+	waBinary "github.com/polymorfa/hypermeow/binary"
+	"testing"
+	"time"
+)
+
+func TestParseUserTextStatus(t *testing.T) {
+	node := waBinary.Node{Tag: "text_status", Attrs: waBinary.Attrs{"text": "Current About", "ephemeral_duration_sec": "86400"}, Content: []waBinary.Node{{Tag: "emoji", Attrs: waBinary.Attrs{"content": "👋"}}}}
+	status := parseUserTextStatus(node)
+	if status == nil || *status.Text != "Current About" || status.Emoji.Content != "👋" || status.Duration.Duration != 24*time.Hour {
+		t.Fatalf("modern About metadata lost: %#v", status)
+	}
+	status = parseUserTextStatus(waBinary.Node{Tag: "text_status"})
+	if status == nil || *status.Text != "" || !status.Duration.IsZero() || status.Emoji != nil {
+		t.Fatal("empty modern status must remain an explicit clear")
+	}
+	status = parseUserTextStatus(waBinary.Node{Tag: "text_status", Content: []waBinary.Node{{Tag: "error"}}})
+	if status != nil {
+		t.Fatal("unavailable modern status must permit the existing legacy value")
+	}
+}
