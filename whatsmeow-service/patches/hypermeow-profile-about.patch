+// parseUserTextStatus keeps modern About separate from the legacy status field.
+func parseUserTextStatus(node waBinary.Node) *types.SetStatusInput {
+	if _, failed := node.GetOptionalChildByTag("error"); failed {
+		return nil
+	}
+	ag := node.AttrGetter()
+	text := ag.OptionalString("text")
+	status := &types.SetStatusInput{Text: &text, Duration: jsontime.S(time.Duration(ag.OptionalInt("ephemeral_duration_sec")) * time.Second)}
+	if emoji, ok := node.GetOptionalChildByTag("emoji"); ok {
+		status.Emoji = &types.SetStatusEmoji{Content: emoji.AttrGetter().OptionalString("content")}
+	}
+	return status
+}
