+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/polymorfa/hypermeow/appstate"
+	waBinary "github.com/polymorfa/hypermeow/binary"
+)
+
+func TestNativePaidLabelTransportWritesOnceWithoutRetry(t *testing.T) {
+	for _, kind := range []string{"success", "conflict", "timeout", "missing", "nil"} {
+		t.Run(kind, func(t *testing.T) {
+			calls := 0
+			send := func(_ context.Context, query infoQuery) (*waBinary.Node, error) {
+				calls++
+				if query.Namespace != "w:sync:app:state" || query.Type != iqSet {
+					t.Fatal("unexpected transport")
+				}
+				if kind == "timeout" {
+					return nil, context.DeadlineExceeded
+				}
+				if kind == "nil" {
+					return nil, nil
+				}
+				if kind == "missing" {
+					return &waBinary.Node{Tag: "iq"}, nil
+				}
+				collection := waBinary.Node{Tag: "collection"}
+				if kind == "conflict" {
+					collection.Attrs = waBinary.Attrs{"type": "error"}
+					collection.Content = []waBinary.Node{{Tag: "error", Attrs: waBinary.Attrs{"code": "409"}}}
+				}
+				return &waBinary.Node{Tag: "iq", Content: []waBinary.Node{{Tag: "sync", Content: []waBinary.Node{collection}}}}, nil
+			}
+			err := sendNativePaidLabelPatchOnce(context.Background(), appstate.WAPatchRegular, 7, []byte("synthetic"), send)
+			if calls != 1 {
+				t.Fatalf("transport wrote %d times", calls)
+			}
+			if kind == "success" && err != nil {
+				t.Fatal(err)
+			}
+			if kind != "success" && err == nil {
+				t.Fatal("invalid response accepted")
+			}
+			if kind == "conflict" && !errors.Is(err, ErrPaidLabelConflict) {
+				t.Fatal("lost definite conflict classification")
+			}
+		})
+	}
+}
