+
+func TestLocalAcceptNotification(t *testing.T) {
+	for _, late := range []bool{false, true} {
+		call := &Call{}
+		notifications := 0
+		if late {
+			call.markLocalAccepted()
+		}
+		call.OnLocalAccept(func() { notifications++; _ = call.State() })
+		call.markLocalAccepted()
+		call.markLocalAccepted()
+		if notifications != 1 {
+			t.Fatalf("late=%v: notifications=%d", late, notifications)
+		}
+	}
+}
+
+func TestMultiRelayReplayFilter(t *testing.T) {
+	filter := newRtpReplayFilter()
+	if filter.Duplicate(1, 65535) || !filter.Duplicate(1, 65535) {
+		t.Fatal("duplicate packet from another relay must be dropped")
+	}
+	if filter.Duplicate(2, 65535) {
+		t.Fatal("different SSRC must not collide")
+	}
+	if filter.Duplicate(1, 0) || !filter.Duplicate(1, 0) {
+		t.Fatal("sequence wrap must work")
+	}
+	for sequence := uint16(1); sequence <= 1024; sequence++ {
+		if filter.Duplicate(1, sequence) {
+			t.Fatalf("new sequence %d must pass", sequence)
+		}
+	}
+	if filter.Duplicate(1, 0) {
+		t.Fatal("evicted sequence must not be kept forever")
+	}
+}
