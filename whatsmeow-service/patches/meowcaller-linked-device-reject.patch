--- /dev/null
+++ b/engine_linked_device_reject_test.go
@@ -0,0 +1,67 @@
+package meowcaller
+
+import (
+	"testing"
+
+	waBinary "github.com/polymorfa/hypermeow/binary"
+
+	"github.com/polymorfa/hypermeow/types"
+	"github.com/polymorfa/hypermeow/types/events"
+)
+
+func TestLinkedDeviceRejection(t *testing.T) {
+	primary := peerJID().ToNonAD()
+	desktop := primary
+	desktop.Device = 22
+	otherDesktop := primary
+	otherDesktop.Device = 26
+	for _, tc := range []struct {
+		name      string
+		rejecting types.JID
+		preaccept types.JID
+		answering types.JID
+		ended     bool
+		reason    string
+	}{
+		{name: "unsupported secondary before preaccept", rejecting: desktop},
+		{name: "unsupported secondary while phone rings", rejecting: desktop, preaccept: primary},
+		{name: "different secondary while desktop rings", rejecting: otherDesktop, preaccept: desktop},
+		{name: "unsupported secondary after preaccept", rejecting: desktop, preaccept: desktop, reason: "unsupported"},
+		{name: "primary decline", rejecting: primary, preaccept: desktop, ended: true},
+		{name: "desktop decline after preaccept without capability", rejecting: desktop, preaccept: desktop, ended: true},
+		{name: "phone dismissal after desktop answered", rejecting: primary, answering: desktop},
+		{name: "desktop dismissal after phone answered", rejecting: desktop, answering: primary},
+		{name: "answering device decline", rejecting: desktop, answering: desktop, ended: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			e, call := testEngineWithOutgoingCall()
+			if !tc.preaccept.IsEmpty() {
+				e.onPreAccept(&events.CallPreAccept{BasicCallMeta: types.BasicCallMeta{CallID: call.ID(), From: tc.preaccept}})
+			}
+			e.calls[call.ID()].answeringDevice = tc.answering
+			e.onReject(&events.CallReject{BasicCallMeta: types.BasicCallMeta{CallID: call.ID(), From: tc.rejecting}, Data: &waBinary.Node{Tag: "reject", Attrs: waBinary.Attrs{"reason": tc.reason}}})
+			if got := call.State() == CallPhaseEnded; got != tc.ended {
+				t.Fatalf("call ended = %v, want %v", got, tc.ended)
+			}
+		})
+	}
+}
+
+func TestSecondaryRejectionPreservesOtherRingingDevice(t *testing.T) {
+	e, call := testEngineWithOutgoingCall()
+	desktop := peerJID().ToNonAD()
+	desktop.Device = 25
+	otherDesktop := desktop
+	otherDesktop.Device = 27
+	for _, device := range []types.JID{desktop, otherDesktop} {
+		e.onPreAccept(&events.CallPreAccept{BasicCallMeta: types.BasicCallMeta{CallID: call.ID(), From: device}})
+	}
+	e.onReject(&events.CallReject{BasicCallMeta: types.BasicCallMeta{CallID: call.ID(), From: desktop}})
+	if call.State() == CallPhaseEnded {
+		t.Fatal("one secondary rejection ended the call while another device was ringing")
+	}
+	e.onReject(&events.CallReject{BasicCallMeta: types.BasicCallMeta{CallID: call.ID(), From: otherDesktop}})
+	if call.State() != CallPhaseEnded {
+		t.Fatal("rejection by the last ringing device did not end the call")
+	}
+}
